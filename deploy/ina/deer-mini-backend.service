[Unit]
Description=deer-mini API (inA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The existing inA checkout, .env and data are owned by root.
User=root
WorkingDirectory=/home/pl/deer_mini/backend
ExecStart=/home/pl/deer_mini/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8005 --workers 1 --root-path /ai --proxy-headers --forwarded-allow-ips 127.0.0.1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target

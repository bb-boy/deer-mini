# 中国科大词元计划的 API Key。
# 这里只保留空模板，禁止填写真实密钥。
USTC_LLM_API_KEY=

# 中国科大 OpenAI 兼容接口地址。
USTC_LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1

# 可选：SQLite 与 Thread 文件根目录。联调/测试时可指向独立绝对路径。
DEER_MINI_DATABASE_PATH=
DEER_MINI_DATA_ROOT=

# 一次 Agent Loop 最多运行多少秒；默认四分钟。
DEER_MINI_RUN_TIMEOUT_SECONDS=240

# Run 结束后保留内存 SSE 事件的秒数，供短暂断线重连；长期历史来自 SQLite
DEER_MINI_STREAM_RETENTION_SECONDS=60
# 单个 Workspace 上传文件的最大字节数，默认 10 MiB
DEER_MINI_MAX_UPLOAD_BYTES=10485760

# 是否把真实 Bash 工具暴露给模型。默认关闭；开启前宿主机必须安装 Docker。
DEER_MINI_BASH_ENABLED=false

# Thread 复用容器的镜像；必须包含 /bin/bash 和支持 infinity 的 sleep。
DEER_MINI_BASH_IMAGE=python:3.12-slim

# 单条 Bash 命令的最长执行时间和最多保留的输出字节数。
DEER_MINI_BASH_TIMEOUT_SECONDS=60
DEER_MINI_BASH_MAX_OUTPUT_BYTES=20000

# 同一 Thread 的容器跨 Run 复用；闲置 10 分钟后由后台回收。
# 单进程部署；启动时会清理本项目上一个进程遗留的容器。
DEER_MINI_SANDBOX_IDLE_TIMEOUT_SECONDS=600
DEER_MINI_SANDBOX_CHECK_INTERVAL_SECONDS=60

# 单个 Bash 容器的资源上限，防止命令挤占整个宿主机。
DEER_MINI_BASH_MEMORY_LIMIT=512m
DEER_MINI_BASH_CPU_LIMIT=1
DEER_MINI_BASH_PIDS_LIMIT=64

# 默认禁止 Bash 容器访问网络；只在明确需要且理解风险时开启。
DEER_MINI_BASH_NETWORK_ENABLED=false

# 可选：Docker CLI 路径；默认使用 PATH 中的 docker。
DEER_MINI_DOCKER_BINARY=docker
